{
	"name": "rpiv-ask-user-question-lean",
	"version": "0.1.1",
	"description": "Token-lean wrapper around @juicesharp/rpiv-ask-user-question: identical features, trimmed tool description and schema. Upstream is a pinned dependency, wrapped via Proxy.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/cabi/rpiv-ask-user-question-lean.git"
	},
	"type": "module",
	"private": true,
	"main": "src/index.ts",
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"measure": "tsx scripts/measure.ts"
	},
	"dependencies": {
		"@juicesharp/rpiv-ask-user-question": "2.13.9",
		"@juicesharp/rpiv-config": "2.13.9"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*",
		"@earendil-works/pi-tui": "*",
		"@juicesharp/rpiv-i18n": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"js-tiktoken": "^1.0.20",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
